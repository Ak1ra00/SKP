---
import { site } from '../data/site';

const { provider, key } = site.form;
const configured = provider !== '' && key.trim().length > 0;

/**
 * Both providers accept a POST of FormData and answer with JSON when the
 * request carries `Accept: application/json`.
 *   web3forms — fixed endpoint, the key travels in the body as `access_key`
 *   formspree — the key *is* the endpoint
 */
const action = !configured
  ? undefined
  : provider === 'web3forms'
    ? 'https://api.web3forms.com/submit'
    : key.trim();

const accessKey = configured && provider === 'web3forms' ? key.trim() : null;
---

<form
  class="form"
  id="contact-form"
  method="POST"
  action={action}
  data-configured={configured ? 'true' : 'false'}
  novalidate
>
  {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
  <input type="hidden" name="subject" value={`New message from ${site.url}`} />
  {/* Populated on submit so Reply goes to the sender, not the provider. */}
  <input type="hidden" name="replyto" id="cf-replyto" value="" />

  <div class="field">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  {/* Spam traps. A real person never fills these in. */}
  <div class="hp" aria-hidden="true">
    <label for="cf-company">Company</label>
    <input id="cf-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    <input name="botcheck" type="checkbox" tabindex="-1" />
  </div>

  <button class="btn" type="submit" id="cf-submit">Send message</button>

  <p class="form-note" id="cf-note" role="status" aria-live="polite" hidden></p>

  {
    !configured && (
      <p class="form-note">
        Not connected yet — set <code>form.provider</code> and{' '}
        <code>form.key</code> in <code>src/data/site.ts</code>. See the README
        for the two-minute version.
      </p>
    )
  }
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    var note = document.getElementById('cf-note');
    var btn = document.getElementById('cf-submit');
    var label = btn.textContent;

    function say(state, text) {
      note.hidden = false;
      note.setAttribute('data-state', state);
      note.textContent = text;
    }

    function invalidField() {
      var name = form.elements['name'];
      var email = form.elements['email'];
      var message = form.elements['message'];
      if (!name.value.trim()) return [name, 'Please enter your name.'];
      if (!email.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim()))
        return [email, 'Please enter a valid email address.'];
      if (!message.value.trim()) return [message, 'Please enter a message.'];
      return null;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var bad = invalidField();
      if (bad) {
        say('err', bad[1]);
        bad[0].focus();
        return;
      }

      if (form.dataset.configured !== 'true') {
        say('err', 'This form is not connected to a delivery service yet.');
        return;
      }

      // Reply-to follows whoever filled the form in.
      var replyto = document.getElementById('cf-replyto');
      if (replyto) replyto.value = form.elements['email'].value.trim();

      btn.disabled = true;
      btn.textContent = 'Sending…';
      say('', 'Sending your message…');

      // Give up rather than spin forever if the network stalls.
      var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timedOut = false;
      var timer = setTimeout(function () {
        timedOut = true;
        if (ctrl) ctrl.abort();
      }, 15000);

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
        signal: ctrl ? ctrl.signal : undefined,
      })
        .then(function (r) {
          return r.json().catch(function () { return {}; }).then(function (data) {
            return { ok: r.ok, data: data };
          });
        })
        .then(function (res) {
          // web3forms reports its own success flag; formspree uses the status.
          if (res.ok && res.data.success !== false) {
            form.reset();
            say('ok', 'Thanks — your message has been sent.');
          } else {
            say('err', 'That did not go through. Please try again shortly.');
          }
        })
        .catch(function () {
          say(
            'err',
            timedOut
              ? 'That took too long. Please check your connection and try again.'
              : 'Network error — please check your connection and retry.'
          );
        })
        .finally(function () {
          clearTimeout(timer);
          btn.disabled = false;
          btn.textContent = label;
        });
    });
  })();
</script>
