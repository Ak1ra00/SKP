---
import { site } from '../data/site';

const configured = site.formEndpoint.trim().length > 0;
---

<form
  class="form"
  id="contact-form"
  method="POST"
  action={configured ? site.formEndpoint : undefined}
  data-configured={configured ? 'true' : 'false'}
>
  <div class="field">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  <!-- Spam trap: a real person never fills this in. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-company">Company</label>
    <input id="cf-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button class="btn" type="submit">Send message</button>

  <p class="form-note" id="cf-note" hidden></p>

  {
    !configured && (
      <p class="form-note">
        This form isn’t connected yet. Add a Formspree endpoint to
        <code> src/data/site.ts </code> to start receiving messages.
      </p>
    )
  }
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var note = document.getElementById('cf-note');
    var btn = form.querySelector('button[type=submit]');

    function say(state, text) {
      note.hidden = false;
      note.setAttribute('data-state', state);
      note.textContent = text;
    }

    form.addEventListener('submit', function (e) {
      if (form.dataset.configured !== 'true') {
        e.preventDefault();
        say('err', 'This form is not connected to a delivery service yet.');
        return;
      }

      e.preventDefault();
      btn.disabled = true;
      say('', 'Sending…');

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
        .then(function (r) {
          if (r.ok) {
            form.reset();
            say('ok', 'Thanks — your message has been sent.');
          } else {
            say('err', 'Something went wrong. Please try again.');
          }
        })
        .catch(function () {
          say('err', 'Network error. Please try again.');
        })
        .finally(function () {
          btn.disabled = false;
        });
    });
  })();
</script>
