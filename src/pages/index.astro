---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import heroImage from '../assets/hero-facility.jpg';

const year = new Date().getFullYear();
---

<Base>
  <header class="site-header">
    <div class="shell">
      <a class="wordmark" href="/">
        <span class="wordmark-badge">{site.initials}</span>
        <span>{site.name}</span>
      </a>

      <div class="header-actions">
        <button class="theme-toggle" type="button" aria-label="Toggle colour theme">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-media">
        <Image
          src={heroImage}
          alt=""
          widths={[900, 1400, 2000, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="shell">
        <div class="hero-inner">
          <p class="eyebrow">{site.location}</p>
          <h1>{site.name}</h1>
          <p class="hero-role">
            <strong>{site.role}</strong> — {site.statement}
          </p>

          <div class="hero-meta">
            {
              site.yearsExperience && (
                <span><i class="dot"></i>{site.yearsExperience}+ years in the field</span>
              )
            }
            <span><i class="dot"></i>Aerospace &amp; advanced manufacturing</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--alt">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">What I do</p>
          <h2>Keeping automated production running.</h2>
          <p>
            Robots are only useful when they run. My work sits where the
            hardware, the software, and the people on the floor meet.
          </p>
        </div>

        <div class="cards">
          {
            site.capabilities.map((cap, i) => (
              <article class="card">
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{cap.title}</h3>
                <p>{cap.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="shell">
        <div class="contact-grid">
          <div class="contact-aside">
            <div class="section-head" style="margin-bottom: 0;">
              <p class="eyebrow">Contact</p>
              <h2>Get in touch.</h2>
              <p>
                For roles, contract work, or a copy of my resume — send a note
                and I’ll get back to you.
              </p>
            </div>

            <ul class="contact-points">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>
                  <strong>Los Angeles, California</strong>
                  Open to on-site roles across the greater LA area.
                </span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <path d="M14 2v6h6M9 15h6M9 11h3"></path>
                </svg>
                <span>
                  <strong>Resume on request</strong>
                  Full work history and references sent directly, not posted here.
                </span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
                <span>
                  <strong>Quick to reply</strong>
                  Messages usually answered within a couple of days.
                </span>
              </li>
            </ul>
          </div>

          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <span>© {year} <strong>{site.name}</strong></span>
      <span class="credit">Facility photograph courtesy of NASA (public domain).</span>
    </div>
  </footer>
</Base>
