---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import heroImage from '../assets/hero-facility.jpg';

const year = new Date().getFullYear();
---

<Base>
  <header class="site-header">
    <div class="shell">
      <a class="wordmark" href="/">
        <span class="wordmark-badge">{site.initials}</span>
        <span>{site.name}</span>
      </a>

      <div class="header-actions">
        <button class="theme-toggle" type="button" aria-label="Toggle colour theme">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-media">
        <Image
          src={heroImage}
          alt=""
          widths={[900, 1400, 2000, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="shell">
        <div class="hero-inner">
          <p class="eyebrow">{site.location}</p>
          <h1>{site.name}</h1>
          <p class="hero-role">
            <strong>{site.role}</strong> — {site.statement}
          </p>

          <div class="hero-meta">
            {
              site.yearsExperience && (
                <span><i class="dot"></i>{site.yearsExperience}+ years in the field</span>
              )
            }
            <span><i class="dot"></i>Aerospace &amp; advanced manufacturing</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--alt">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">What I do</p>
          <h2>Keeping automated production running.</h2>
          <p>
            Robots are only useful when they run. My work sits where the
            hardware, the software, and the people on the floor meet.
          </p>
        </div>

        <div class="cards">
          {
            site.capabilities.map((cap, i) => (
              <article class="card">
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{cap.title}</h3>
                <p>{cap.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="project">
      <div class="shell">
        <div class="project-panel">
          <p class="eyebrow">Off the clock</p>

          <div class="project-head">
            <h2>{site.project.name}</h2>
          </div>

          <p class="project-tagline">{site.project.tagline}</p>
          <p class="project-body">{site.project.body}</p>

          <ul class="project-points">
            {
              site.project.points.map((point) => (
                <li>
                  <i class="bullet" aria-hidden="true"></i>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>

          <ul class="tags">
            {site.project.stack.map((t) => <li class="tag">{t}</li>)}
          </ul>

          <div class="project-actions">
            <div class="project-links">
              <a class="project-link project-link--primary" href={site.project.site} rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                </svg>
                Visit site
              </a>

              <a class="project-link" href={site.project.repo} rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path>
                </svg>
                View source
              </a>
            </div>

            <p class="project-note">{site.project.note}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="contact">
      <div class="shell">
        <div class="contact-grid">
          <div class="contact-aside">
            <div class="section-head" style="margin-bottom: 0;">
              <p class="eyebrow">Contact</p>
              <h2>Get in touch.</h2>
              <p>
                For roles, contract work, or a copy of my resume — send a note
                and I’ll get back to you.
              </p>
            </div>

            <ul class="contact-points">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>
                  <strong>Los Angeles, California</strong>
                  Open to on-site roles across the greater LA area.
                </span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <path d="M14 2v6h6M9 15h6M9 11h3"></path>
                </svg>
                <span>
                  <strong>Resume on request</strong>
                  Full work history and references sent directly, not posted here.
                </span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
                <span>
                  <strong>Quick to reply</strong>
                  Messages usually answered within a couple of days.
                </span>
              </li>
            </ul>
          </div>

          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <span>© {year} <strong>{site.name}</strong></span>
      <span class="credit">Facility photograph courtesy of NASA (public domain).</span>
    </div>
  </footer>
</Base>
